# Сервер tsg-bitrix (Railway → Variables)
BITRIX_WEBHOOK_URL=https://top-cleaning.bitrix24.kz/rest/239/xxxxxxxxxxxx/
MCP_TOKEN_TEAMLEAD=
MCP_TOKEN_PRODUCTION=
MCP_TOKEN_ACCOUNT=
MCP_TOKEN_ACCOUNTANT=
# необязательно
ENABLED_ROLES=teamlead,production,account,accountant
JOURNAL_PATH=
ENTITY_IDS=
FIELD_OVERRIDES=

# Для scripts/setup_agents.py и scripts/ask.py
ANTHROPIC_API_KEY=
MCP_BASE_URL=https://tsg-bitrix-production.up.railway.app
SESSION_BUDGET_CENTS=200

# Telegram-бот (второй сервис Railway из того же репозитория)
APP=bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=          # ваш Telegram ID; позже через запятую ID Акмарал
TEAMLEAD_AGENT_ID=             # печатает scripts/setup_agents.py
AGENTS_ENVIRONMENT_ID=
AGENTS_VAULT_ID=
STT_PROVIDER=groq              # groq (как у HR-бота), openai или yandex
GROQ_API_KEY=                  # распознавание голосовых
OPENAI_API_KEY=                # только для ответа голосом (/voice) или STT_PROVIDER=openai
YANDEX_API_KEY=                # если STT_PROVIDER=yandex
STT_LANG=ru-RU                 # только для yandex: ru-RU или kk-KZ
SUMMARY_TIME=19:00             # пусто — без автоматической сводки
SUMMARY_CHAT_IDS=
